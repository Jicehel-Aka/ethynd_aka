# Fins de ligne : les scripts doivent rester en LF (un script bash en CRLF ne s'execute pas sous Linux/CI)
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# fichiers binaires
*.bin binary
*.map binary
*.raw binary
*.png binary
*.zip binary
